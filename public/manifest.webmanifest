{
  "id": "/",
  "name": "Plan zajęć",
  "short_name": "Plan zajęć",
  "description": "Plan zajęć w interfejsie natywnej aplikacji Android: dzień, tydzień, miesiąc, semestr, materiały i 20 stylów.",
  "lang": "pl",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "orientation": "any",
  "background_color": "#04070c",
  "theme_color": "#04070c",
  "categories": ["education", "productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png?v=21", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png?v=21", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png?v=21", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png?v=21", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/apple-touch-icon-180.png?v=21", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Dzień",
      "short_name": "Dzień",
      "description": "Plan na dziś",
      "url": "/?view=day",
      "icons": [{ "src": "/icons/icon-192.png?v=21", "sizes": "192x192" }]
    },
    {
      "name": "Tydzień",
      "short_name": "Tydzień",
      "description": "Siatka godzin na cały tydzień",
      "url": "/?view=week",
      "icons": [{ "src": "/icons/icon-192.png?v=21", "sizes": "192x192" }]
    },
    {
      "name": "Miesiąc",
      "short_name": "Miesiąc",
      "description": "Kalendarz miesiąca",
      "url": "/?view=month",
      "icons": [{ "src": "/icons/icon-192.png?v=21", "sizes": "192x192" }]
    }
  ]
}
