[Unit]
Description=Plan zajec (wybor grupy) - kalendarz z harmonogramow uczelni
Documentation=https://plany.mati-it.pl
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=plan
Group=plan
WorkingDirectory=/opt/plan-grupy
Environment=NODE_ENV=production
Environment=TZ=Europe/Warsaw
EnvironmentFile=-/opt/plan-grupy/.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

# Podstawowe utwardzenie usługi
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/plan-grupy/.cache
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
