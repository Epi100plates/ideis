<?xml version="1.0" encoding="utf-8"?>
<!--
  Tylko build **debug**: pozwala rozmawiać z lokalnym serwerem po HTTP podczas
  testów (`-Pplanzajec.apiBase=http://10.0.2.2:3311`). Wydanie release zostaje
  bez zmian — tam API chodzi po HTTPS i czysty tekst jest nadal zablokowany.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
