<?xml version="1.0" encoding="utf-8"?>
<!--
  30 minut (`updatePeriodMillis`) to najmniejszy interwał, jaki system honoruje.
  Dzięki niemu kafel sam przerysowuje się po zmianie trybu jasny/ciemny także
  wtedy, gdy proces aplikacji nie żyje — Android nie budzi dostawcy widżetu na
  `ACTION_CONFIGURATION_CHANGED`, więc bez tego wpisu tonacja czekałaby na
  otwarcie aplikacji albo pracę cykliczną (60 min).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="pl.matiit.planzajec.widget.WidgetConfigActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minHeight="110dp"
    android:minResizeHeight="70dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/widget_preview_week"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="3"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
