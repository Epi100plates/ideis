# Port serwera (wewnątrz kontenera)
PORT=3000
HOST=0.0.0.0
# Strefa czasu harmonogramu (weekend liczony w czasie polskim)
TZ=Europe/Warsaw

# Numer (ID) grupy domyślnej — używany, gdy w adresie nie ma ?group=NNNN
#   https://harmonogramy.ideis.pl/Plany/PlanyGrup/21188  ->  21188
GROUP_ID=21188

# Początkowy wybór w pickerze. Katalog zawsze zawiera CAŁĄ uczelnię —
# te wartości tylko podpowiadają, co zaznaczyć na starcie.
#   DEFAULT_NABOR  — rok rozpoczęcia studiów (2026 = nabór 2026/2027);
#                    puste = bieżący rok akademicki
#   DEFAULT_FIELD  — kierunek (dokładna nazwa z katalogu)
#   DEFAULT_SPEC   — specjalność; puste = dowolna (na 1. roku zwykle jej nie ma)
#   DEFAULT_YEAR   — rok studiów (1–6)
#   DEFAULT_DEGREE — typ studiów: 1st, 2st, jmgr, podypl, inż
#   DEFAULT_MODE   — tryb: N (niestacjonarne), S (stacjonarne)
DEFAULT_NABOR=
DEFAULT_FIELD=Informatyka
DEFAULT_SPEC=
DEFAULT_YEAR=1
DEFAULT_DEGREE=1st
DEFAULT_MODE=N

# Harmonogram automatycznego odświeżania planu (minuty).
# Wymaganie: dni robocze raz na dobę, weekendy raz na godzinę.
REFRESH_WEEKDAY_MIN=1440
REFRESH_WEEKEND_MIN=60

# Ile wersji planu trzymać w pamięci dla zwykłej grupy (PINNED ma 200)
MAX_VERSIONS=40

# Ile grup trzymać jednocześnie w pamięci i po ilu dniach bez wejścia je zwolnić
MAX_ACTIVE_GROUPS=8
GROUP_IDLE_DAYS=14

# Po jakim czasie cache grupy uznajemy za nieświeży przy wejściu na stronę (minuty).
# 1440 = doba; odświeżanie w tle i tak wymusza własny rytm.
CACHE_TTL_MIN=1440

# Token wymagany do POST /api/refresh (puste = bez zabezpieczenia).
# Uwaga: przy NODE_ENV=production (obraz Docker) puste REFRESH_TOKEN znaczy
# „wymuszone odświeżanie wyłączone” — web schodzi wtedy do zwykłego GET planu.
# Ten sam token chroni `?refresh=1` (/api/groups, /api/ideis/kierunki,
# /api/ideis/specjalnosci): jedno żądanie pobiera ~500 KB katalogu z uczelni.
REFRESH_TOKEN=

# Timeout pobrania katalogu grup z uczelni (ms).
CATALOG_TIMEOUT_MS=30000

# Minimalny odstęp (sekundy) między ręcznymi sprawdzeniami z przycisku.
# Chroni serwer uczelni, gdy strona jest publiczna. 0 = bez limitu.
REFRESH_MIN_GAP_S=60

# Ilu klientów naraz może pytać o plan (/api/plan, /api/version, eksporty).
# Każdy nowy numer grupy to wpis w rejestrze i pobranie z uczelni, więc limit
# chroni przed enumeracją numerów.
PLAN_RATE_PER_MIN=240

# Ile pobrań planu z uczelni może iść jednocześnie (ochrona harmonogramów).
FETCH_CONCURRENCY=2

# Po nieudanym pobraniu tyle sekund nie pytamy uczelni o tę samą grupę
# (cache negatywny; przycisk „Odśwież” omija go świadomie).
NEGATIVE_CACHE_S=120

# Komu ufać w nagłówkach CF-Connecting-IP / X-Forwarded-For (klucz limitów):
#   private (domyślnie) — pętla lokalna i sieci prywatne (Docker, tunel),
#   all                 — każde połączenie (własny reverse proxy przed aplikacją),
#   none                — tylko adres gniazda (port wystawiony wprost do internetu).
TRUST_PROXY=private

# Załączniki do zajęć (notatki, PDF, Office, OpenDocument, obrazy). Katalog
# domyślnie leży w CACHE_DIR/attachments, czyli w Dockerze na wolumenie ./data.
# ATTACHMENT_DIR=/var/lib/plany-wybor/attachments
ATTACHMENT_MAX_MB=25
ATTACHMENT_CLASS_MAX_MB=200
ATTACHMENT_MAX_FILES=30
# Linki do materiałów mają własny limit i nie zużywają limitu plików.
ATTACHMENT_LINK_MAX=30
# Globalny limit miejsca na wszystkie załączniki (ochrona dysku VPS)
ATTACHMENT_TOTAL_MAX_MB=2048

# Maksymalna liczba uploadów na adres IP w ciągu minuty.
ATTACHMENT_RATE_PER_MIN=20

# Ile uploadów może naraz buforować ciało w RAM (każdy do ATTACHMENT_MAX_MB).
# Ponad limit serwer odpowiada 429 — lepsze to niż OOM na VPS bez swapa.
MAX_CONCURRENT_UPLOADS=2
# Limit bezczynności przy wysyłaniu ciała uploadu (sekundy) — po nim żądanie
# jest zrywane, żeby wolno sączący się klient nie trzymał bufora i gniazda.
UPLOAD_TIMEOUT_S=120

# Licznik wejść (przeglądarka + PWA + aplikacja Android). Strona: /licznik.
# Plik licznika domyślnie leży w CACHE_DIR/visits.json (w Dockerze ./data).
# COUNTER_HOST puste = brak przekierowania „/” na stronę licznika.
COUNTER_HOST=
APP_URL=https://ideis.mati-it.pl/
# VISITS_FILE=/var/lib/plany-wybor/visits.json
# Limit zliczeń na IP na minutę (ochrona przed zalewaniem pliku).
VISIT_RATE_PER_MIN=240

# Formularz uczelni (/Plany/ZnajdzTok): stały wydział i cache list wyboru.
#   DEFAULT_FACULTY_ID / LABEL — wydział zawsze wybrany w kreatorze
#   IDEIS_COMBO_TTL_MIN        — jak długo trzymać listy kierunków/specjalności
DEFAULT_FACULTY_ID=5453
DEFAULT_FACULTY_LABEL=Wydział Studiów Stosowanych we Wrocławiu
IDEIS_COMBO_TTL_MIN=720

# Plan z kilku grup (wykład + ćwiczenia/laby/lektorat): ile grup może mieć jeden plan.
MAX_PLAN_GROUPS=12

# Propozycje i błędy (anonimowe). Strona: /propozycje, API: /api/feedback.
#   FEEDBACK_DIR           — katalog z feedback.jsonl (domyślnie CACHE_DIR/feedback)
#   FEEDBACK_TOKEN         — token moderacji (usuwanie zgłoszeń; puste = wyłączone)
#   FEEDBACK_RATE_PER_MIN  — limit zgłoszeń na IP
FEEDBACK_RATE_PER_MIN=10
FEEDBACK_TOKEN=
# FEEDBACK_DIR=/var/lib/plany-wybor/feedback

# Katalog cache (domyślnie ./.cache; w Dockerze /app/.cache)
# CACHE_DIR=/var/lib/plany-wybor

# Wydania aplikacji Android (APK). Aplikacja nie jest w sklepie, więc pyta ten
# serwer o nową wersję (`GET /api/app/latest`). Manifest `latest.json` i pliki
# `.apk` leżą w katalogu wydań — jego zmiana nie wymaga przebudowy kontenera.
# APP_RELEASE_DIR=/app/.cache/releases
# Identyfikator aplikacji; manifest opisujący inną aplikację jest odrzucany.
APP_ID=pl.matiit.planzajec.ideis
